# Development-only placeholders. Do not reuse these values in production.
POSTGRES_DB=septem_cinemas
POSTGRES_USER=septem
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://septem:local_development_only@localhost:5432/septem_cinemas?schema=public

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3333
WEB_ORIGIN=http://localhost:5173
# Ligue apenas se a API estiver atrás de um proxy confiável (Railway, por
# exemplo). Sem proxy, confiar em X-Forwarded-For permitiria forjar a origem.
TRUST_PROXY=false
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
TICKET_SIGNING_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
TMDB_READ_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token

VITE_API_URL=http://localhost:3333
