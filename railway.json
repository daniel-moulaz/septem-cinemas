{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run prisma:generate && npm run build --workspace @septem/api"
  },
  "deploy": {
    "preDeployCommand": ["npm run db:migrate:deploy"],
    "startCommand": "npm run start --workspace @septem/api",
    "healthcheckPath": "/health"
  }
}
