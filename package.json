{
  "name": "septem-cinemas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @septem/web",
    "dev:api": "npm run dev --workspace @septem/api",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run prisma:generate && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run prisma:generate && npm run build --workspaces --if-present",
    "check": "npm run prisma:validate && npm run lint && npm run typecheck && npm test && npm run build",
    "prisma:validate": "npm run prisma:validate --workspace @septem/api",
    "prisma:generate": "npm run prisma:generate --workspace @septem/api",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:check": "npm run db:check --workspace @septem/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @septem/api --",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @septem/api",
    "db:seed": "npm run db:seed --workspace @septem/api",
    "test:concurrency-proof": "node scripts/concurrency-proof.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
